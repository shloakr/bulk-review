OPENAI_API_KEY=sk-...

# Models (Responses API)
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_QUALIFIER_MODEL=gpt-5.6-luna
OPENAI_EXTRACTOR_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Qdrant: set QDRANT_URL to use a server (docker compose up -d).
# Leave empty to use embedded local mode persisted at QDRANT_LOCAL_PATH.
QDRANT_URL=
QDRANT_LOCAL_PATH=.qdrant_local

# Concurrency / bounds
MAX_MODEL_CONCURRENCY=5
MAX_TOOL_CALLS_PER_DOC=8
CANDIDATE_DOC_BUDGET=100
